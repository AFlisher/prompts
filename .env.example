SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
BACKEND_URL=https://your-backend-host

# SEC-0.1 - Google Cloud project number linked to this app in Play Console.
# Not a secret (it ships inside the APK). Leave unset to disable Play Integrity
# entirely: the app then sends no integrity header and the backend decides what
# that means. Required before integrity tokens can be minted.
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
